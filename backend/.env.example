# 复制为 backend/.env 后按需修改

# 运行时数据库（asyncpg）
DATABASE_URL=postgresql+asyncpg://shiguang:shiguang@localhost:5432/shiguang_lottery

# Alembic 迁移用同步 URL（留空则自动推导）
# DATABASE_URL_SYNC=postgresql+psycopg://shiguang:shiguang@localhost:5432/shiguang_lottery

# CORS 白名单
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent 编排层（OpenAI 兼容接口；留空 LLM_API_KEY 则降级为内置关键词路由）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 大乐透默认启用奖池≥8亿联动
DEFAULT_POOL_HIGH=true
