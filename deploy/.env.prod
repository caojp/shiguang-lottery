# 时光选彩 · 生产环境配置模板
# 部署时复制为 deploy/.env（勿提交 git），并修改以下值：
#   POSTGRES_PASSWORD —— 必改，换成强密码（长度 ≥ 16，混合大小写数字符号）
#   LLM_API_KEY        —— 可选，留空则 Agent 层自动降级为内置关键词路由

POSTGRES_PASSWORD=请改为强密码

# Agent 编排层（OpenAI 兼容接口）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 大乐透默认启用"奖池≥8亿"固定奖联动
DEFAULT_POOL_HIGH=true
